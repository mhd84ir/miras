# Copy to .env (gitignored) and fill in. Never commit .env.

# openssl rand -hex 32
SECRET_KEY=

# Bare hostname (Caddy) and full origin (GlitchTip) for the same domain.
GLITCHTIP_HOST=crash.example.ir
GLITCHTIP_DOMAIN=https://crash.example.ir

# Where GlitchTip sends invites/alerts. consolemail:// (default) logs instead
# of sending — fine until email alerting matters.
# Example: smtp://user:password@smtp.example.ir:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=you@example.ir
