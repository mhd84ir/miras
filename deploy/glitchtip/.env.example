# Copy to .env (gitignored) and fill in. Never commit .env.
# Shared VPS with tebtejarat.com: use compose.nginx.yml (not compose.yml + Caddy).

# openssl rand -hex 32
SECRET_KEY=

# Bare hostname (Caddy / docs) and full origin (GlitchTip) for the same domain.
GLITCHTIP_HOST=miras.tebtejarat.com
GLITCHTIP_DOMAIN=https://miras.tebtejarat.com
ALLOWED_HOSTS=miras.tebtejarat.com,localhost,127.0.0.1

# Where GlitchTip sends invites/alerts. consolemail:// (default) logs instead
# of sending — fine until email alerting matters.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@tebtejarat.com

# Set True only for first bootstrap, then False
ENABLE_USER_REGISTRATION=True
ENABLE_ORGANIZATION_CREATION=True

# Required for login behind Nginx (include trailing-dot FQDN variant if browsers send it)
CSRF_TRUSTED_ORIGINS=https://miras.tebtejarat.com,https://miras.tebtejarat.com.
