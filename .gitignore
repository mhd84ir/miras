# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.iml

# Dart / Flutter (applies to app/ and tool/ packages)
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/doc/api/

# Android
**/local.properties
**/*.keystore
**/key.properties
# Kotlin compiler session scratch (created next to the Gradle project)
**/.kotlin/

# iOS (phase 3)
**/Pods/
**/.symlinks/

# Generated code
app/lib/core/l10n/gen/
app/lib/**/*.g.dart

# Generated content pack (built by tool/content_compiler)
app/assets/content/

# Test artifacts
coverage/
**/failures/

# Content pipeline scratch (piper binaries/voice models, misc caches).
# Generated audio IS committed — content/audio_cache/ — so CI builds
# audio-complete packs without a synthesis backend (ADR-0008).
tool/content_compiler/.cache/

# Secrets (TTS API keys for the content pipeline)
.env
*.env.local
